# OpenAI API key — required for the car analysis to work.
# Create one at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Optional: override the OpenAI model. Must support Structured Outputs.
# Defaults to gpt-4o.
OPENAI_MODEL=gpt-4o

# Optional: Synsbasen API for plate lookup and official register data.
SYNSBASEN_API_KEY=
# SYNSBASEN_BASE_URL=https://api.synsbasen.dk/v1
# Set to true to enable debt/lien (tinglysning) lookups. Requires a paid plan.
SYNSBASEN_ENABLE_TINGLYSNING=false
